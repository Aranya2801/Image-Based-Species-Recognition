# ============================================================
# Image-Based Species Recognition — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── Model Configuration ──────────────────────────────────────
MODEL=ensemble                          # ensemble | efficientnet_v2_l | vit_large_16
DEVICE=auto                             # auto | cuda | cpu
WEIGHTS_PATH=checkpoints/best_model.pth
N_CLASSES=10000

# ── API Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=INFO

# ── Inference Settings ───────────────────────────────────────
CONFIDENCE_THRESHOLD=0.10
TOP_K=5
UNCERTAINTY_PASSES=20
GRADCAM_ENABLED=false

# ── MLflow Tracking ──────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=species-recognition

# ── Weights & Biases (optional) ──────────────────────────────
# WANDB_API_KEY=your_key_here
# WANDB_PROJECT=species-recognition
# WANDB_ENTITY=your_username

# ── Kaggle (for dataset download) ────────────────────────────
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# ── Redis (for prediction caching) ───────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
